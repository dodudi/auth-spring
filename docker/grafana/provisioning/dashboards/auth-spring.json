{
  "id": null,
  "uid": "auth-spring",
  "title": "Auth Spring Monitoring",
  "tags": ["auth-spring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    { "id": 1, "type": "row", "title": "Overview", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 2, "type": "stat", "title": "총 요청 수 (RPS)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"auth-spring\"}[1m]))", "refId": "A", "legendFormat": "RPS" }]
    },

    {
      "id": 3, "type": "stat", "title": "에러율 (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"auth-spring\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"auth-spring\"}[1m])) * 100", "refId": "A", "legendFormat": "Error %" }]
    },

    {
      "id": 4, "type": "stat", "title": "P95 응답시간",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"auth-spring\"}[5m])) by (le)) * 1000", "refId": "A", "legendFormat": "P95" }]
    },

    {
      "id": 5, "type": "stat", "title": "로그인 실패",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } } },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[LOGIN_FAILURE]\" [$__range]))", "refId": "A", "instant": true, "range": false, "legendFormat": "Failures" }]
    },

    { "id": 10, "type": "row", "title": "Security", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "id": 11, "type": "timeseries", "title": "로그인 성공 vs 실패",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[LOGIN_SUCCESS]\" [1m]))", "refId": "A", "instant": false, "range": true, "legendFormat": "Success" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[LOGIN_FAILURE]\" [1m]))", "refId": "B", "instant": false, "range": true, "legendFormat": "Failure" }
      ]
    },

    {
      "id": 12, "type": "piechart", "title": "소셜 로그인 유형",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 8 },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[SOCIAL_LOGIN]\" != \"LINK\" != \"NEW\" [$__range]))", "refId": "A", "instant": true, "range": false, "legendFormat": "Returning" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[SOCIAL_LOGIN_LINK]\" [$__range]))", "refId": "B", "instant": true, "range": false, "legendFormat": "Link" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[SOCIAL_LOGIN_NEW]\" [$__range]))", "refId": "C", "instant": true, "range": false, "legendFormat": "New" }
      ]
    },

    {
      "id": 13, "type": "timeseries", "title": "신규 가입 추이",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[USER_SIGNUP]\" [1m]))", "refId": "A", "instant": false, "range": true, "legendFormat": "Form" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\"} |= \"[SOCIAL_LOGIN_NEW]\" [1m]))", "refId": "B", "instant": false, "range": true, "legendFormat": "Social" }
      ]
    },

    {
      "id": 14, "type": "logs", "title": "최근 로그인 실패",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "options": { "showTime": true, "showLabels": false, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "expr": "{app=\"auth-spring\"} |= \"[LOGIN_FAILURE]\"", "refId": "A", "instant": false, "range": true }]
    },

    { "id": 20, "type": "row", "title": "API Performance", "collapsed": false, "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 } },

    {
      "id": 21, "type": "timeseries", "title": "엔드포인트별 RPS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"auth-spring\"}[1m])) by (uri)", "refId": "A", "legendFormat": "{{uri}}" }]
    },

    {
      "id": 22, "type": "timeseries", "title": "평균 응답시간 (by URI)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_sum{job=\"auth-spring\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"auth-spring\"}[1m])) by (uri) * 1000", "refId": "A", "legendFormat": "{{uri}}" }]
    },

    {
      "id": 23, "type": "barchart", "title": "HTTP 상태 코드 분포",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "options": { "xField": "status" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(http_server_requests_seconds_count{job=\"auth-spring\"}[$__range])) by (status)", "refId": "A", "legendFormat": "{{status}}", "instant": true }]
    },

    {
      "id": 24, "type": "timeseries", "title": "WARN / ERROR 로그 추이",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\", level=\"WARN\"} [1m]))", "refId": "A", "instant": false, "range": true, "legendFormat": "WARN" },
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({app=\"auth-spring\", level=\"ERROR\"} [1m]))", "refId": "B", "instant": false, "range": true, "legendFormat": "ERROR" }
      ]
    },

    { "id": 30, "type": "row", "title": "System Health", "collapsed": false, "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 } },

    {
      "id": 31, "type": "timeseries", "title": "JVM 힙 메모리",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(jvm_memory_used_bytes{job=\"auth-spring\", area=\"heap\"})", "refId": "A", "legendFormat": "Used" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(jvm_memory_max_bytes{job=\"auth-spring\", area=\"heap\"})", "refId": "B", "legendFormat": "Max" }
      ]
    },

    {
      "id": 32, "type": "timeseries", "title": "DB 커넥션 풀",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_active{job=\"auth-spring\"}", "refId": "A", "legendFormat": "Active" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_pending{job=\"auth-spring\"}", "refId": "B", "legendFormat": "Pending" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_max{job=\"auth-spring\"}", "refId": "C", "legendFormat": "Max" }
      ]
    },

    {
      "id": 33, "type": "timeseries", "title": "CPU 사용률",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2 }, "max": 1 } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_cpu_usage{job=\"auth-spring\"}", "refId": "A", "legendFormat": "CPU" }]
    },

    {
      "id": 34, "type": "timeseries", "title": "GC 멈춤 시간",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(jvm_gc_pause_seconds_sum{job=\"auth-spring\"}[1m])", "refId": "A", "legendFormat": "{{action}} {{cause}}" }]
    }

  ]
}
